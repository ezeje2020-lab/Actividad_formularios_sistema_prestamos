@{
    ViewData["Title"] = "Home Page";
}
<form action= '@Url.Action("GuardarInfo", "Home")' method="post" >
 
    <h2>Datos personales</h2>
    <input type= "text" name="nombre" placeholder="Ingresar nombre"/>
    <input type= "number" name="edad" min="0" placeholder="Ingresar edad"/>
    <input type= "number" name="DNI" min="1" max="99999999" placeholder="Ingresar DNI"/>

    <h2> Situación laboral </h2>
    <div>
        <h4>¿Actualmente trabaja?</h4>
        <input type= "radio" name="empleo" value= "true"/> Si<br>
        <input type= "radio" name="empleo" value= "false"/>No
    </div>
    <div>
        <p>
            Tipo de empleo:<br>
            <select name="TipoEmpleo">
                <option value="relacionDependencia">Relación de dependencia</option>
                <option value="monotributista">Monotributista</option>
                <option value="autonomo">Autónomo</option>
                <option value="desempleado">Desempleado</option>
            </select>
        </p>
    </div>
    
    <h2>Información económica</h2>
    <input type= "number" name="ingresoMensual" min="0" placeholder="Ingreso Mensual"/>

    <div>
        <h4>¿Posee otras deudas?</h4>
        <input type= "radio" name="deudas" value= "true"/> Si<br>
        <input type= "radio" name="deudas" value= "false"/>No
    </div>
    <div>
        
        <h4>Tipo de deuda</h4>
            <input type= "checkbox" name="tarjetaDeCredito"> Tarjeta De Credito <br>
            <input type= "checkbox" name="prestamoBancario"> Préstamo bancario<br>
            <input type= "checkbox" name="prestamoInformal"> Préstamo informal <br>
    </div>

    <div>
        <h2>Información económica</h2>
            <input type= "number" name="montoSolicitado" min="0" placeholder="Monto solicitado"/>

            <p>
                Tipo de empleo:
                <select name= "PlazoDeDevolución">
                    <option value="6">6 meses</option>
                    <option value="12">12 meses</option>
                    <option value="24">24 meses</option>
                </select>
            </p>

    </div>

    <h2>Confirmación</h2>
    <input type= "checkbox" name="acepto" value="true"> Acepta términos y condiciones<br>
    
    <br><input type="submit" value="Guardar" />
    <input type="reset" value="Borrar formulario" />

</form>